          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/ProjectCreated"
        }
      },
      "errors": [
        {
          "code": -32602,
          "message": "invalid argument",
          "data": {
            "kind": "invalid_argument"
          }
        },
        {
          "code": 401,
          "message": "unauthenticated",
          "data": {
            "kind": "unauthenticated"
          }
        },
        {
          "code": 409,
          "message": "already exists",
          "data": {
            "kind": "already_exists"
          }
        },
        {
          "code": 503,
          "message": "unavailable",
          "data": {
            "kind": "unavailable"
          }
        },
        {
          "code": 504,
          "message": "deadline exceeded",
          "data": {
            "kind": "deadline_exceeded"
          }
        }
      ],
      "examples": [
        {
          "name": "website",
          "params": [
            {
              "name": "key",
              "value": "WEB"
            },
            {
              "name": "name",
              "value": "Website"
            }
          ],
          "result": {
            "name": "result",
            "value": {
              "id": "01997aa0-4c80-7a3e-9d21-5b6f0c1e2a3b",
              "key": "WEB",
              "name": "Website",
              "created_at": "2026-09-24T09:00:00Z"
