        {
          "name": "projects"
        }
      ],
      "paramStructure": "by-name",
      "params": [
        {
          "name": "key",
          "description": "A short code of the project, of A-Z and 0-9, starting with a letter, such as WEB. The projects of a caller have keys of their own.",
