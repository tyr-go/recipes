{
  "name": "tasks-client",
  "private": true,
  "description": "A typed client of the service tasks, generated from its OpenAPI document",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../../api/openapi.json --output src/schema.d.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  }
}
